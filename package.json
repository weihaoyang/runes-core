{
  "name": "@singseq/runes-core",
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "description": "Elder Futhark 符文与抽取",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts src/data.ts src/draw.ts src/nine-worlds.ts src/serializer.ts --format esm,cjs --dts --clean",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "tsup": "8.5.1"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "LICENSES",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weihaoyang/runes-core.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./data": {
      "import": {
        "types": "./dist/data.d.ts",
        "default": "./dist/data.js"
      },
      "require": {
        "types": "./dist/data.d.cts",
        "default": "./dist/data.cjs"
      }
    },
    "./draw": {
      "import": {
        "types": "./dist/draw.d.ts",
        "default": "./dist/draw.js"
      },
      "require": {
        "types": "./dist/draw.d.cts",
        "default": "./dist/draw.cjs"
      }
    },
    "./nine-worlds": {
      "import": {
        "types": "./dist/nine-worlds.d.ts",
        "default": "./dist/nine-worlds.js"
      },
      "require": {
        "types": "./dist/nine-worlds.d.cts",
        "default": "./dist/nine-worlds.cjs"
      }
    },
    "./serializer": {
      "import": {
        "types": "./dist/serializer.d.ts",
        "default": "./dist/serializer.js"
      },
      "require": {
        "types": "./dist/serializer.d.cts",
        "default": "./dist/serializer.cjs"
      }
    }
  }
}
